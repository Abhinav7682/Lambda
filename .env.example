# ─────────────────────────────────────────────
# Lambda E-Commerce — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env to git.
# ─────────────────────────────────────────────

# Port the Express server listens on
PORT=3000

# Public base URL — used by the dynamic /config.js endpoint to tell the
# frontend where to send API requests.
# Local dev  → http://localhost:3000
# EC2 prod   → http://<your-elastic-ip>   e.g. http://13.204.169.183
API_BASE_URL=http://localhost:3000

# Node environment: development | production
NODE_ENV=development
